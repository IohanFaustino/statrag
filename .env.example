# Keys (source: /home/iohan/Documents/toolbox/tools/AI_brain/Tools/Book_analyzer/.env)
# Suggested: ln -s /home/iohan/Documents/toolbox/tools/AI_brain/Tools/Book_analyzer/.env .env
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_TEXT=stats_textbooks
QDRANT_COLLECTION_IMAGES=stats_images

# Models
OPENAI_EMBED_MODEL=text-embedding-3-large
OPENAI_MODEL_NANO=gpt-5.4-nano-2026-03-17
OPENAI_MODEL_FULL=gpt-5.4-2026-03-05
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEFAULT_PROVIDER=openai
MODEL_NANO_MAX_CTX=300000
MODEL_FULL_MAX_CTX=1000000

# Retrieval weights (Ensemble RRF)
DENSE_WEIGHT=0.6
SPARSE_WEIGHT=0.4
TOP_K=5

# Backwards-compat aliases used by src/config.py
EMBEDDING_MODEL=text-embedding-3-large
LLM_MODEL=gpt-5.4-nano-2026-03-17
